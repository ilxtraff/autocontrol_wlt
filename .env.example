# ---------- Приложение ----------
# Шифрует мультитокены в базе и подписывает куки сессии.
# МЕНЯТЬ НЕЛЬЗЯ: после смены сохранённые секреты не расшифруются.
AC_SECRET_KEY=change-me-to-a-long-random-string
AC_DATABASE_URL=sqlite:///./autocontrol.db
AC_BIND_HOST=0.0.0.0
AC_BIND_PORT=8000

# Первый вход. Пользователь создаётся при старте, если база пустая.
AC_BOOTSTRAP_LOGIN=admin
AC_BOOTSTRAP_PASSWORD=
AC_BOOTSTRAP_ROLE=admin

# ---------- Движок автоконтроля ----------
# Период тика движка, секунды (в CRM решения идут примерно раз в 10 минут).
AC_TICK_SECONDS=600
# Сколько следим за выключенным адсетом, прежде чем снять контроль. Часы.
AC_RECOVERY_HOURS=3
# Запускать движок внутри веб-процесса. Если гоняете `python -m app.engine` отдельно — выключите.
AC_RUN_ENGINE_IN_WEB=true
# Проверять, не включил ли выключенный адсет человек руками.
AC_HUMAN_RESUME_CHECK=true
# Ничего не выключать/не включать в Facebook, только писать решения в журнал.
AC_DRY_RUN=false

# ---------- Keitaro ----------
# Кейтаро работает в часовом поясе Москвы — окно дня пересчитывается в него.
AC_KEITARO_TIMEZONE=Europe/Moscow
# Поле Keitaro, в котором лежит ID адсета — тот sub_id, на который
# в настройках трекера замаплен параметр adset_id={{adset.id}}.
AC_KEITARO_ADSET_FIELD=sub_id_6
AC_KEITARO_TIMEOUT=45

# ---------- Facebook ----------
AC_FB_API_VERSION=v21.0
AC_FB_TIMEOUT=45

# Отдавать сессионную куку только по HTTPS (включите за прокси с TLS).
AC_COOKIE_SECURE=false
